<?xml version="1.0" encoding="utf-8"?>
<!-- Launch-screen icon: same artwork as the launcher icon, on a cream disc. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="108dp" android:height="108dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/cream" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" android:width="108dp" android:height="108dp" android:gravity="center" />
</layer-list>
